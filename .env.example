# Add non-secret placeholder environment variables here.
# Never commit real secrets.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://sales:sales@localhost:5432/sales_management
DEV_TOKEN_SECRET=local-dev-token-secret-change-me
INTEGRATION_API_KEY=local-integration-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=no-reply@cherrylab.com
SMTP_USE_TLS=true

# GCP Cloud Run deployment placeholders
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-northeast3
GCP_ARTIFACT_REPOSITORY=sales-management
GCP_BACKEND_SERVICE=sales-management-backend
GCP_FRONTEND_SERVICE=sales-management-frontend
GCP_CLOUD_SQL_INSTANCE=your-gcp-project-id:asia-northeast3:sales-management-db

# Optional SQLite fallback for quick local troubleshooting
# DATABASE_URL=sqlite:///./.local/sales_management.db
